<Window x:Class="ResurgeLauncherCSharp.ModsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mods Manager" Height="600" Width="900"
        Background="#121212" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Mods &amp; Usermaps Manager" FontSize="28" FontWeight="Bold" Foreground="#ff6600"/>
            <TextBlock Text="This tool automatically detects and fixes custom maps and mods that crash because they aren't inside a 'zone' folder." Foreground="#aaaaaa" Margin="0,5,0,0"/>
        </StackPanel>
        
        <ListBox x:Name="ModsListBox" Grid.Row="1" Background="#1a1a1a" BorderThickness="0" Margin="0,0,0,20" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" IsItemsHost="True" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2d2d2d" CornerRadius="8" Margin="10" Width="260" Padding="15" BorderBrush="#444" BorderThickness="1">
                        <StackPanel>
                            <Border CornerRadius="6" ClipToBounds="True" Height="146" Margin="0,0,0,10" Background="#111">
                                <Image Source="{Binding IconImage}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding Type}" Foreground="#cccccc" FontSize="12" Margin="0,2,0,5"/>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding WorkshopJsonPath}" Foreground="#888888" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" ToolTip="{Binding WorkshopJsonPath}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Refresh List" Width="150" Height="40" Margin="0,0,20,0" Click="RefreshButton_Click" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Fix All Folder Structures" Width="250" Height="40" Click="FixAllButton_Click" Background="#ff6600" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
