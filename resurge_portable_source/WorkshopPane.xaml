<UserControl x:Class="ResurgeLauncherCSharp.WorkshopPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Search and filters -->
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search" Style="{StaticResource Primary}" Click="Search_Click" Margin="8,0,0,0"/>
            <Grid>
                <TextBox x:Name="SearchText" AutomationProperties.Name="Search the Workshop" KeyDown="SearchText_KeyDown" TextChanged="SearchText_TextChanged" Padding="38,9,11,9"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="Search by name, or paste a Steam Workshop link" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>
        <WrapPanel Margin="0,0,0,16">
            <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CatAll" Content="Everything" GroupName="WorkshopCategory" Style="{StaticResource Segment}" IsChecked="True" Checked="Filter_Changed"/>
                    <RadioButton x:Name="CatMaps" Content="Maps" GroupName="WorkshopCategory" Style="{StaticResource Segment}" Checked="Filter_Changed"/>
                    <RadioButton x:Name="CatMods" Content="Mods" GroupName="WorkshopCategory" Style="{StaticResource Segment}" Checked="Filter_Changed"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,6">
                <StackPanel x:Name="SortButtons" Orientation="Horizontal"/>
            </Border>
        </WrapPanel>

        <!-- Active download -->
        <Border x:Name="DownloadCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed" BorderBrush="{StaticResource Accent}">
            <DockPanel>
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Cancel" Click="CancelButton_Click" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel>
                    <TextBlock x:Name="DownloadTitle" Text="Downloading" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <ProgressBar x:Name="Activity" Margin="0,9,0,7" Maximum="100"/>
                    <TextBlock x:Name="DownloadDetail" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="ResultCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
            <TextBlock x:Name="BrowseStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>

        <!-- Results -->
        <ItemsControl x:Name="Results">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,14" ClipToBounds="True">
                        <StackPanel>
                            <Grid Height="150">
                                <Border CornerRadius="10,10,0,0" Background="#10161E"/>
                                <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip><RectangleGeometry Rect="0,0,2000,150" RadiusX="10" RadiusY="10"/></Image.Clip>
                                </Image>
                                <Border Style="{StaticResource Chip}" Background="#D0090C11" Margin="10" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Eyebrow}" FontSize="11"/>
                                </Border>
                            </Grid>
                            <StackPanel Margin="14,12,14,14">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"/>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10" TextWrapping="NoWrap">
                                    <Run Text="{Binding SubscribersText, Mode=OneWay}"/><Run Text="   ·   "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                </TextBlock>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Steam ↗" Style="{StaticResource Quiet}" Padding="8,7" Click="OpenOnSteam_Click" Tag="{Binding Id}"/>
                                    <Button Content="{Binding InstallText}" Padding="14,7" HorizontalAlignment="Left" Click="Install_Click" Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,18">
            <Button x:Name="PrevPage" Content="‹  Previous" Click="PrevPage_Click" Margin="0,0,10,0"/>
            <TextBlock x:Name="PageText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,16,0"/>
            <Button x:Name="NextPage" Content="Next  ›" Click="NextPage_Click"/>
        </StackPanel>

        <!-- Import from a Steam library -->
        <Expander x:Name="LocalImport" Header="Already have maps from Steam? Import them" Foreground="{StaticResource Ink}">
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Pick Steam's Black Ops III workshop folder (steamapps\workshop\content\311210) to copy every item you already downloaded."/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseButton_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="WorkshopPathText" AutomationProperties.Name="Steam workshop content folder"/>
                    </DockPanel>
                    <Button x:Name="ImportBtn" Content="Import everything from this folder" Click="ImportButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Expander>
        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
