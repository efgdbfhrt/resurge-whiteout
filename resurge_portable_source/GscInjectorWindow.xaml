<Window x:Class="ResurgeLauncherCSharp.GscInjectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GSC Injector" Height="450" Width="500"
        Background="#121212" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="GSC Studio Injector" FontSize="24" FontWeight="Bold" Foreground="#ff6600"/>
            <TextBlock Text="Select a .gsc file to inject into Black Ops III." Foreground="#aaaaaa" Margin="0,5,0,0"/>
        </StackPanel>
        
        <ListBox x:Name="GscListBox" Grid.Row="1" Background="#2d2d2d" Foreground="White" BorderBrush="#555" Margin="0,0,0,20" Padding="10"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Refresh List" Width="150" Height="40" Margin="0,0,20,0" Click="RefreshButton_Click" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Inject Selected" Width="200" Height="40" Click="InjectButton_Click" Background="#ff6600" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#aaaaaa" Margin="0,15,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>
