<Window x:Class="ResurgeLauncherCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ResurgeLauncherCSharp"
        Title="Resurge Whiteout" Width="1280" Height="830" MinWidth="1060" MinHeight="680"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="{x:Type local:SidebarTab}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:SidebarTab}">
                        <Grid MinHeight="46" Margin="0,0,0,3" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="SidebarPointer">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.15"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="PointerRest"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SidebarSelection">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.2"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="InactiveTab"/>
                                    <VisualState x:Name="ActiveTab">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverWash" CornerRadius="8" Background="#12FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="SelectedFill" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#40FF7A2F" Offset="0"/>
                                        <GradientStop Color="#08FF7A2F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Indicator" Width="3" Margin="0,10" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{StaticResource Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Border.RenderTransform><ScaleTransform x:Name="IndicatorScale" ScaleY=".3"/></Border.RenderTransform>
                            </Border>
                            <ContentPresenter ContentSource="Header" Margin="16,0,12,0" VerticalAlignment="Center"/>
                            <Border x:Name="KeyboardFocusRing" CornerRadius="8" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="Stepper" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
    </Window.Resources>

    <Grid UseLayoutRounding="True" ClipToBounds="True">
        <!-- Background art: Black Ops III key art on the right, or a full-window picture -->
        <Grid x:Name="ArtLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Border x:Name="BackgroundImage" Grid.Column="1" RenderTransformOrigin=".5,.3" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                    <ImageBrush x:Name="BackgroundBrush" ImageSource="Assets/Whiteout-Ridge.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top"/>
                </Border.Background>
                <Border.RenderTransform><ScaleTransform x:Name="ArtZoom"/></Border.RenderTransform>
            </Border>
        </Grid>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                    <GradientStop Color="#FA07090C" Offset="0"/>
                    <GradientStop Color="#E607090C" Offset=".34"/>
                    <GradientStop Color="#6607090C" Offset=".62"/>
                    <GradientStop Color="#3307090C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" VerticalAlignment="Bottom" Height="320">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0007090C" Offset="0"/>
                    <GradientStop Color="#F007090C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <local:WhiteoutBackdrop x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True"/>

        <Grid x:Name="Shell">
            <Grid.RenderTransform><TranslateTransform x:Name="Entrance"/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <TabControl x:Name="Navigation" TabStripPlacement="Left" SelectionChanged="Navigation_SelectionChanged"
                        Foreground="{StaticResource Ink}" Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#CC090C11" BorderBrush="#1F2833" BorderThickness="0,0,1,0">
                                <DockPanel Margin="16,24,16,16">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                                        <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource Accent}">
                                            <Border.Effect><DropShadowEffect Color="#FF7A2F" BlurRadius="20" ShadowDepth="0" Opacity=".45"/></Border.Effect>
                                            <Path Data="M 0,16 L 8,0 L 12,0 L 5,16 Z M 9,16 L 17,0 L 21,0 L 14,16 Z" Fill="{StaticResource AccentInk}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="RESURGE" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="21"/>
                                            <TextBlock Text="WHITEOUT  ·  BLACK OPS III" FontFamily="{StaticResource Display}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Profile card -->
                                    <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource Quiet}" Padding="0" Click="ChangeAvatar_Click"
                                                    ToolTip="Change profile picture" AutomationProperties.Name="Change profile picture">
                                                <Grid Width="42" Height="42">
                                                    <Ellipse Fill="#2A3442"/>
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Ink}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="BadgeAvatar"/>
                                                    <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="1.5"/>
                                                </Grid>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Padding="8" Click="SignOut_Click"
                                                    ToolTip="Sign out" AutomationProperties.Name="Sign out" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                            </Button>
                                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="BadgeName" Text="Player" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock x:Name="BadgeDetail" Text="Local profile" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLabel" Text="Whiteout 2.7" Foreground="{StaticResource Faint}"
                                               FontSize="11" Margin="8,0,0,0"/>
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" VerticalAlignment="Top"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="1"/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ============================== PLAY ============================== -->
                <local:SidebarTab x:Name="PlayTab" AutomationProperties.Name="Play">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Play" VerticalAlignment="Center"/>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <StackPanel Margin="44,38,44,36">
                        <!-- First-run setup -->
                        <Border x:Name="UpdateCard" Style="{StaticResource Card}" BorderBrush="{StaticResource Good}" Margin="0,0,0,18" Visibility="Collapsed"
                                AutomationProperties.AutomationId="UpdateCard">
                            <DockPanel>
                                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Update now" Style="{StaticResource Primary}" Click="Update_Click"
                                        VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.AutomationId="UpdateButton"/>
                                <StackPanel>
                                    <TextBlock Text="UPDATE AVAILABLE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Good}"/>
                                    <TextBlock x:Name="UpdateTitle" Text="A new Whiteout version is ready" Style="{StaticResource CardTitle}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="UpdateNotes" Style="{StaticResource Hint}" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar x:Name="UpdateProgress" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border x:Name="SetupCard" Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Margin="0,0,0,26" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="FINISH SETUP" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Two quick steps before your first game" Style="{StaticResource CardTitle}" Margin="0,4,0,12"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="SetupFolderButton" DockPanel.Dock="Right" Content="Choose folder" Click="SelectFolderButton_Click" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SetupFolderMark" Text="1" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Accent}" Width="26" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Black Ops III game folder" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SetupFolderText" Text="The folder that contains zone." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Find it for me" Click="FindClient_Click" Margin="0,0,8,0"/>
                                        <Button Content="Choose Resurge.dll" Click="SelectBundle_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SetupClientMark" Text="2" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Accent}" Width="26" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Resurge game client" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SetupClientText" Text="Resurge.dll from the original Resurge launcher." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="BLACK OPS III  ·  RESURGE CLIENT" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="WelcomeText" Text="Ready up, soldier." FontFamily="{StaticResource Display}" FontSize="54" FontWeight="Bold" Margin="-2,6,0,4"/>
                        <TextBlock Text="Zombies with every official map, Multiplayer with bots, the Steam Workshop and your friends in one place."
                                   Foreground="#C6D0DC" FontSize="15" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,26"/>
                        <StackPanel x:Name="PlayRow" Orientation="Horizontal">
                            <Grid>
                                <Border x:Name="PlayGlow" CornerRadius="9" Background="{StaticResource Accent}" Margin="4" IsHitTestVisible="False" Opacity=".35">
                                    <Border.Effect><BlurEffect Radius="26"/></Border.Effect>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From=".18" To=".6" Duration="0:0:1.6">
                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Button x:Name="LaunchResurgeButton" Style="{StaticResource PlayButton}" Click="LaunchResurgeButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="PLAY" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ReadyDot" Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ReadyText" Text="Game ready" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="UnlockSummary" Text="Unlocks off" Foreground="{StaticResource Muted}" FontSize="13" Margin="16,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid x:Name="ModeCards" Columns="3" Margin="-7,34,-7,0">
                            <Button Style="{StaticResource Tile}" Margin="7" Click="LaunchResurgeButton_Click" Height="150">
                                <Grid Margin="20,18">
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="☠" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="Zombies" Style="{StaticResource CardTitle}" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="ZombiesSummary" Text="All official maps" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <TextBlock Text="PLAY  ›" Style="{StaticResource Eyebrow}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource Tile}" Margin="7" Click="GoMultiplayer_Click" Height="150">
                                <Grid Margin="20,18">
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="&#xE716;" Style="{StaticResource TileIcon}"/>
                                        <TextBlock Text="Multiplayer vs Bots" Style="{StaticResource CardTitle}" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="BotsSummary" Text="Bots off" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <TextBlock Text="SET UP  ›" Style="{StaticResource Eyebrow}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource Tile}" Margin="7" Click="GoFriends_Click" Height="150">
                                <Grid Margin="20,18">
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="&#xE8FA;" Style="{StaticResource TileIcon}"/>
                                        <TextBlock Text="Friends" Style="{StaticResource CardTitle}" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="FriendsSummary" Text="See who's online" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <TextBlock Text="OPEN  ›" Style="{StaticResource Eyebrow}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                </Grid>
                            </Button>
                        </UniformGrid>

                        <UniformGrid x:Name="StatCards" Columns="4" Margin="-7,8,-7,0">
                            <Border Style="{StaticResource Card}" Margin="7">
                                <StackPanel>
                                    <TextBlock Text="PLAY TIME" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="ProfilePlayTime" Text="0m" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="7">
                                <StackPanel>
                                    <TextBlock Text="BEST ROUND" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="ProfileBestRound" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="7">
                                <StackPanel>
                                    <TextBlock Text="OFFICIAL MAPS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="OfficialMapCount" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Tile}" Margin="7" Click="GoWorkshop_Click">
                                <StackPanel Margin="20,18">
                                    <TextBlock Text="WORKSHOP ITEMS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="WorkshopCount" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="18,13">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Change" Click="GoSettings_Click" Style="{StaticResource Quiet}"/>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="InstallSummary" Text="Choose your Black Ops III folder in Settings." Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </local:SidebarTab>

                <!-- ============================== MULTIPLAYER ============================== -->
                <local:SidebarTab x:Name="MultiplayerTab" AutomationProperties.Name="Multiplayer">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Multiplayer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <StackPanel Margin="44,38,44,36">
                        <TextBlock Text="MULTIPLAYER" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Bots" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Fill every lobby you host with bots so matches start full, even with no other players online." Style="{StaticResource PageIntro}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="BotsEnabled" Style="{StaticResource Switch}" Checked="BotSetting_Changed" Unchecked="BotSetting_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Fill my lobbies with bots" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Custom Games and offline Multiplayer start with the teams below." Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,18"/>

                                <TextBlock Text="DIFFICULTY" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="BotDiff0" Content="Recruit" GroupName="BotDifficulty" Style="{StaticResource Segment}" Checked="BotSetting_Changed"/>
                                        <RadioButton x:Name="BotDiff1" Content="Regular" GroupName="BotDifficulty" Style="{StaticResource Segment}" Checked="BotSetting_Changed"/>
                                        <RadioButton x:Name="BotDiff2" Content="Hardened" GroupName="BotDifficulty" Style="{StaticResource Segment}" Checked="BotSetting_Changed"/>
                                        <RadioButton x:Name="BotDiff3" Content="Veteran" GroupName="BotDifficulty" Style="{StaticResource Segment}" Checked="BotSetting_Changed" IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2" Margin="0,20,0,0" HorizontalAlignment="Left">
                                    <StackPanel Margin="0,0,48,0">
                                        <TextBlock Text="YOUR TEAM SIZE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="−" Style="{StaticResource Stepper}" Click="AlliesDown_Click" AutomationProperties.Name="Smaller team"/>
                                            <TextBlock x:Name="BotAlliesText" Text="6" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" Width="48" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="+" Style="{StaticResource Stepper}" Click="AlliesUp_Click" AutomationProperties.Name="Bigger team"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ENEMY TEAM SIZE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="−" Style="{StaticResource Stepper}" Click="EnemiesDown_Click" AutomationProperties.Name="Smaller enemy team"/>
                                            <TextBlock x:Name="BotEnemiesText" Text="6" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" Width="48" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="+" Style="{StaticResource Stepper}" Click="EnemiesUp_Click" AutomationProperties.Name="Bigger enemy team"/>
                                        </StackPanel>
                                    </StackPanel>
                                </UniformGrid>

                                <Border Background="#0FFFFFFF" CornerRadius="8" Padding="14,11" Margin="0,22,0,0">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="13">
                                        <Run Text="In game:" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <Run Text="Multiplayer  ›  Custom Games  ›  Start Game. Every place not taken by a real player is filled with a bot."/>
                                    </TextBlock>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="Play Multiplayer" Style="{StaticResource Primary}" Click="LaunchResurgeButton_Click" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="BotStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander Header="Community servers (EZZ BOIII · Steam copy)" Foreground="{StaticResource Ink}" Margin="0,22,0,0" FontWeight="SemiBold">
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Server addresses (optional)" Style="{StaticResource CardTitle}" FontWeight="Normal"/>
                                    <TextBlock Text="Leave empty to search the EZZ public directory, or enter one host:port per line. Joining requires boiii.exe and a Steam copy of the game." Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                                    <TextBox x:Name="ServerAddresses" AutomationProperties.Name="Public server addresses" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Height="72" MaxLength="3000" FontWeight="Normal"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="FindMatchButton" Content="Find a match" Style="{StaticResource Primary}" Click="FindMatch_Click" Margin="0,0,8,6"/>
                                        <Button Content="Save addresses" Click="SaveServers_Click" Margin="0,0,8,6"/>
                                        <Button Content="Export host preset" Click="ExportServer_Click" Margin="0,0,8,6"/>
                                        <Button x:Name="LaunchEzzButton" Content="Launch EZZ BOIII" Click="LaunchEzzButton_Click" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,12"/>
                                    <TextBlock x:Name="PublicResult" Text="No search yet" FontSize="17" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="PublicDetails" Text="The host preset fills empty places with Veteran bots and leaves room for joining players." Style="{StaticResource Hint}" FontWeight="Normal"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="JoinPublicButton" Content="Join" IsEnabled="False" Click="JoinPublic_Click" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                                        <Button x:Name="CopyJoinButton" Content="Copy /connect" IsEnabled="False" Click="CopyJoin_Click"/>
