                <!-- ============================== WORKSHOP ============================== -->
                <local:SidebarTab x:Name="WorkshopTab" AutomationProperties.Name="Workshop">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Workshop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <StackPanel Margin="44,38,44,36">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="WorkshopBrowseMode" Content="Browse" GroupName="WorkshopMode" Style="{StaticResource Segment}" IsChecked="True" Checked="WorkshopMode_Changed"/>
                                    <RadioButton x:Name="WorkshopInstalledMode" Content="Installed" GroupName="WorkshopMode" Style="{StaticResource Segment}" Checked="WorkshopMode_Changed"/>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="STEAM WORKSHOP  ·  APP 311210" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Workshop" Style="{StaticResource PageTitle}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Search every custom map and mod, install with one click, then pick it in game under Zombies › Change Map. You can also paste a Workshop link." Style="{StaticResource PageIntro}"/>

                        <local:WorkshopPane x:Name="WorkshopPanel"/>

                        <StackPanel x:Name="LibraryPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,12">
                                <WrapPanel DockPanel.Dock="Right">
