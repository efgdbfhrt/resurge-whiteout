                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding RemoveText}" Tag="{Binding}" Click="UninstallItem_Click" Style="{StaticResource Quiet}"
                                                        VerticalAlignment="Center" Visibility="{Binding RemoveVisibility}"
                                                        AutomationProperties.Name="{Binding RemoveName}"/>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" VerticalAlignment="Center" Width="92" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Type}" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </local:SidebarTab>

                <!-- ============================== UNLOCKS ============================== -->
                <local:SidebarTab x:Name="UnlocksTab" AutomationProperties.Name="Unlocks">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE785;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Unlocks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <StackPanel Margin="44,38,44,36">
                        <TextBlock Text="PROGRESSION" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Unlocks" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Changes apply the next time you press Play. They work in normal Resurge sessions, online included." Style="{StaticResource PageIntro}"/>

                        <!-- Mastery camos: earned with total zombie kills -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" AutomationProperties.AutomationId="MasteryCard">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="MasteryKillsText" Text="0" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold"
                                                   HorizontalAlignment="Right" AutomationProperties.AutomationId="MasteryKillsText"/>
                                        <TextBlock Text="zombie kills" Style="{StaticResource Hint}" Margin="0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="MASTERY CAMOS" Style="{StaticResource Eyebrow}" FontSize="11"/>
                                        <TextBlock Text="Earn animated camos with zombie kills" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="MasteryNextText" Style="{StaticResource Hint}" Text="Kills with any weapon count."/>
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar x:Name="MasteryProgress" Margin="0,12,0,4" Maximum="1" Height="6"/>
                                <ItemsControl x:Name="MasteryTiers" Margin="-6,10,-6,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6" CornerRadius="10" Background="{StaticResource Raised}" BorderBrush="{Binding Frame}" BorderThickness="1" Padding="10">
                                                <StackPanel>
                                                    <Grid Height="130" Margin="0,0,0,8">
                                                        <Border CornerRadius="7" ClipToBounds="True">
                                                            <Border.Background><ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/></Border.Background>
                                                        </Border>
                                                        <Border CornerRadius="7" Background="#B0080A0E" Visibility="{Binding LockVisibility}">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource Ink}"/>
                                                                <TextBlock Text="{Binding Remaining}" FontSize="12" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Tier.Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding Requirement}" Foreground="{Binding Accent}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0"
                                           Text="In game: Weapon Kits › Camo › Extras. An earned camo replaces the camo named on its card. Kills are counted when you're back in the Zombies menu; kills from before this update don't count."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="UnlockAllButton" DockPanel.Dock="Right" Content="Unlock everything" Style="{StaticResource Primary}" Click="UnlockAll_Click" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Unlock all" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Turns on every option below in one click." Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,6"/>
                                <CheckBox x:Name="StatsCamos" Style="{StaticResource Switch}" Margin="0,10" Checked="Unlock_Changed" Unchecked="Unlock_Changed">
                                    <StackPanel>
                                        <TextBlock Text="All camos" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Every Multiplayer and Zombies camo, including Gold and Diamond." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="StatsAttachments" Style="{StaticResource Switch}" Margin="0,10" Checked="Unlock_Changed" Unchecked="Unlock_Changed">
                                    <StackPanel>
                                        <TextBlock Text="All attachments" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Every attachment on every weapon, without levelling up." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="StatsWeapons" Style="{StaticResource Switch}" Margin="0,10" Checked="Unlock_Changed" Unchecked="Unlock_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Max weapon level" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Weapons at their highest level in Multiplayer and Zombies." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="StatsRank" Style="{StaticResource Switch}" Margin="0,10" Checked="Unlock_Changed" Unchecked="Unlock_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Level 1000" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Master Prestige rank in Zombies and Multiplayer." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="MegaAll" Style="{StaticResource Switch}" Margin="0,10" Checked="Unlock_Changed" Unchecked="Unlock_Changed">
                                    <StackPanel>
                                        <TextBlock Text="All Mega GobbleGums ×999" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Every Mega flavor in your inventory, ready for GobbleGum packs." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GobbleGum editor" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Pick a flavor to set its own amount or put it in Pack 1." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
                                    <ListBox x:Name="GumGrid" SelectionChanged="GumSelector_Changed" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="370" AutomationProperties.Name="Mega GobbleGums">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Frame" Width="66" Height="66" Margin="3" CornerRadius="33" BorderThickness="2" BorderBrush="Transparent"
                                                                    ToolTip="{Binding Name}" RenderTransformOrigin=".5,.5">
                                                                <Border.RenderTransform><ScaleTransform x:Name="Pop"/></Border.RenderTransform>
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="#88FFFFFF"/>
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.12"/>
                                                                                <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.12"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                                                <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                                    <Setter TargetName="Frame" Property="Effect">
                                                                        <Setter.Value><DropShadowEffect Color="#FF7A2F" BlurRadius="16" ShadowDepth="0" Opacity=".7"/></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid Visibility="{Binding FallbackVisibility}">
                                                        <Ellipse Fill="{Binding Color}"/>
                                                        <TextBlock Text="{Binding Glyph}" Foreground="White" FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0FFFFFFF" CornerRadius="10" Padding="18" Margin="18,0,0,0">
                                    <StackPanel>
                                        <Grid Width="120" Height="120" HorizontalAlignment="Left">
                                            <Grid x:Name="GumFallback">
                                                <Ellipse x:Name="GumColor" Fill="#62458E" Stroke="#DBDFF4" StrokeThickness="1.4"/>
                                                <TextBlock x:Name="GumArt" Text="✦" Foreground="White" FontSize="30" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Image x:Name="GumIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Effect><DropShadowEffect Color="#FF7A2F" BlurRadius="24" ShadowDepth="0" Opacity=".35"/></Image.Effect>
                                            </Image>
                                        </Grid>
                                        <TextBlock x:Name="GumName" Text="Select a flavor" Style="{StaticResource CardTitle}" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="GumStatus" Style="{StaticResource Hint}" Text="Amount 0–999"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBox x:Name="GumAmount" Width="80" MaxLength="3" AutomationProperties.Name="GobbleGum quantity" Margin="0,0,8,0"/>
                                            <Button Content="Save" Click="SaveGum_Click" Margin="0,0,6,0"/>
                                            <Button Content="Reset" Click="ResetGum_Click" Style="{StaticResource Quiet}"/>
                                        </StackPanel>
                                        <TextBlock Text="PACK 1 SLOT" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,16,0,6"/>
                                        <Border Style="{StaticResource SegmentHost}">
                                            <StackPanel x:Name="GumSlots" Orientation="Horizontal">
                                                <RadioButton Content="1" GroupName="GumSlot" Style="{StaticResource Segment}" IsChecked="True"/>
                                                <RadioButton Content="2" GroupName="GumSlot" Style="{StaticResource Segment}"/>
                                                <RadioButton Content="3" GroupName="GumSlot" Style="{StaticResource Segment}"/>
                                                <RadioButton Content="4" GroupName="GumSlot" Style="{StaticResource Segment}"/>
                                                <RadioButton Content="5" GroupName="GumSlot" Style="{StaticResource Segment}"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Equip in Pack 1" Click="EquipGum_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                        <Button Content="Clear GobbleGum preset" Click="ClearGums_Click" Style="{StaticResource Quiet}" Margin="-10,10,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </local:SidebarTab>

                <!-- ============================== FRIENDS ============================== -->
                <local:SidebarTab x:Name="FriendsTab" AutomationProperties.Name="Friends">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FA;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Friends" VerticalAlignment="Center"/>
                            <Border x:Name="FriendsBadge" Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="FriendsBadgeText" Text="0" Foreground="{StaticResource AccentInk}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <Grid Margin="44,38,44,30">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="SOCIAL" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Friends" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="FriendsIntro" Text="Find players by name, visit their profiles, see who's playing what, and chat with anyone." Style="{StaticResource PageIntro}"/>
                        </StackPanel>

                        <Border x:Name="FriendsUnavailable" Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="FriendsUnavailableTitle" Text="Friends aren't connected yet" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="FriendsUnavailableText" Text="This launcher has no friends server set up." Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                                <Button x:Name="FriendsRetryButton" Content="Try again" Click="FriendsRetry_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="FriendsPanel" Grid.Row="1" MinHeight="520">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <!-- Friend list -->
                            <Border Style="{StaticResource Card}" Padding="14">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <DockPanel x:Name="SearchRow">
                                            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource Primary}" Click="AddFriend_Click" Margin="8,0,0,0" Padding="14,8"
                                                    AutomationProperties.AutomationId="AddFriendButton"/>
                                            <Grid>
                                                <TextBox x:Name="AddFriendName" PreviewKeyDown="AddFriendName_KeyDown" TextChanged="AddFriendName_TextChanged" MaxLength="24"
                                                         AutomationProperties.Name="Find a player" AutomationProperties.AutomationId="AddFriendName"/>
                                                <TextBlock x:Name="AddFriendHint" Text="Find a player…" Foreground="{StaticResource Faint}" IsHitTestVisible="False"
                                                           Margin="13,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>
                                        <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=SearchRow}" Placement="Bottom" StaysOpen="False"
                                               AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=SearchRow}" VerticalOffset="4">
                                            <Border Background="{StaticResource PanelSolid}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="5">
                                                <StackPanel>
                                                    <TextBlock x:Name="SuggestEmpty" Text="No players found." Foreground="{StaticResource Muted}" Margin="8,6" Visibility="Collapsed"/>
                                                    <ItemsControl x:Name="SuggestList" AutomationProperties.AutomationId="SuggestList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="SuggestOpen_Click" Tag="{Binding}" Padding="6" BorderThickness="0" Background="Transparent"
                                                                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Entry.Name}">
                                                                    <DockPanel>
                                                                        <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,10,0">
                                                                            <Ellipse Fill="#2A3442"/>
                                                                            <TextBlock Text="{Binding Initial}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            <Ellipse Fill="{Binding AvatarBrush}"/>
                                                                            <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" Stroke="#0E1218" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                                        </Grid>
                                                                        <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Tag="{Binding}" Click="SuggestAdd_Click" Style="{StaticResource Primary}"
                                                                                Padding="10,4" FontSize="12" VerticalAlignment="Center" Visibility="{Binding ActionVisibility}"
                                                                                AutomationProperties.Name="{Binding ActionName}"/>
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Entry.Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                            <TextBlock Text="{Binding Entry.StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                        <TextBlock x:Name="FriendsStatus" Style="{StaticResource Hint}" Text="Start typing a name to find players." Margin="2,6,0,0"/>
                                        <Button x:Name="MyProfileButton" Click="MyProfile_Click" Style="{StaticResource Quiet}" HorizontalContentAlignment="Stretch" Padding="6" Margin="0,8,0,0"
                                                AutomationProperties.AutomationId="MyProfileButton" AutomationProperties.Name="My profile">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,10,0">
                                                    <Ellipse Fill="#2A3442"/>
                                                    <TextBlock x:Name="MyProfileInitial" Foreground="{StaticResource Ink}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="MyProfileAvatar"/>
                                                </Grid>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="My profile" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Edit your About me" FontSize="11" FontWeight="Normal"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <Border Height="1" Background="{StaticResource Line}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="2,12,2,0" Margin="0,8,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="NotifyToggle" Style="{StaticResource Switch}" IsChecked="True" Checked="NotifySetting_Changed" Unchecked="NotifySetting_Changed"
                                                      AutomationProperties.AutomationId="NotifyToggle">
                                                <StackPanel>
                                                    <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Pop-up for new messages and friend requests." Style="{StaticResource Hint}" FontSize="12" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="NotifySoundToggle" Style="{StaticResource Switch}" IsChecked="True" Margin="0,10,0,0" Checked="NotifySetting_Changed" Unchecked="NotifySetting_Changed"
                                                      AutomationProperties.AutomationId="NotifySoundToggle">
                                                <TextBlock Text="Notification sound" FontWeight="SemiBold"/>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                    <ListBox x:Name="FriendList" Background="Transparent" BorderThickness="0" SelectionChanged="FriendList_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Row" CornerRadius="8" Padding="8" Margin="0,0,0,4" Background="Transparent">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="#12FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="#30FF7A2F"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0">
                                                        <Ellipse Fill="#2A3442"/>
                                                        <TextBlock Text="{Binding Initial}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Ellipse Fill="{Binding AvatarBrush}"/>
                                                        <Ellipse Width="12" Height="12" Fill="{Binding DotBrush}" Stroke="#0E1218" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Visibility="{Binding UnreadVisibility}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Entry.Unread}" Foreground="{StaticResource AccentInk}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Entry.Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <TextBlock Text="{Binding Entry.StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Profile and chat -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" Padding="0">
                                <Grid>
                                    <TextBlock x:Name="FriendEmpty" Text="Pick a friend, or search for any player, to see their profile and chat." Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <DockPanel x:Name="FriendDetail" Visibility="Collapsed">
                                        <Border DockPanel.Dock="Top" Padding="20,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0">
                                                    <Ellipse Fill="#2A3442"/>
                                                    <TextBlock x:Name="FriendInitial" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="FriendAvatar"/>
                                                    <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                                                </Grid>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="AddProfileFriendButton" Content="Add friend" Style="{StaticResource Primary}" Click="AddProfileFriend_Click" Margin="0,0,8,0" Visibility="Collapsed"
                                                            AutomationProperties.AutomationId="AddProfileFriendButton"/>
                                                    <Button x:Name="AcceptFriendButton" Content="Accept" Style="{StaticResource Primary}" Click="AcceptFriend_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                                                    <Button x:Name="RemoveFriendButton" Content="Remove" Style="{StaticResource Quiet}" Click="RemoveFriend_Click"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="FriendName" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold"/>
                                                    <TextBlock x:Name="FriendActivity" Foreground="{StaticResource Muted}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,18,0"><Run Text="PLAY TIME  "/><Run x:Name="FriendPlayTime" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/></TextBlock>
                                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,18,0"><Run Text="BEST ROUND  "/><Run x:Name="FriendBestRound" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/></TextBlock>
                                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12"><Run Text="SESSIONS  "/><Run x:Name="FriendSessions" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/></TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border DockPanel.Dock="Top" Padding="20,12,20,14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="ABOUT ME" Style="{StaticResource Eyebrow}" FontSize="11"/>
                                                <TextBlock x:Name="FriendAbout" Margin="0,4,0,0" AutomationProperties.AutomationId="FriendAbout"/>
                                                <StackPanel x:Name="AboutEditor" Visibility="Collapsed" Margin="0,6,0,0">
                                                    <DockPanel>
                                                        <Button x:Name="SaveAboutButton" DockPanel.Dock="Right" Content="Save" Style="{StaticResource Primary}" Click="SaveAbout_Click" Margin="8,0,0,0"
                                                                VerticalAlignment="Top" AutomationProperties.AutomationId="SaveAboutButton"/>
                                                        <TextBox x:Name="AboutInput" MaxLength="300" TextWrapping="Wrap" MinHeight="38" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                                                 TextChanged="AboutInput_TextChanged" AutomationProperties.Name="About me" AutomationProperties.AutomationId="AboutInput"/>
                                                    </DockPanel>
                                                    <TextBlock x:Name="AboutCount" Style="{StaticResource Hint}" FontSize="11" Text="0 / 300"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ChatBar" DockPanel.Dock="Bottom" Padding="14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                            <DockPanel>
                                                <Button x:Name="SendChatButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="SendChat_Click" Margin="8,0,0,0" Padding="16,8"
                                                        AutomationProperties.Name="Send message">
                                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <TextBox x:Name="ChatInput" KeyDown="ChatInput_KeyDown" MaxLength="500" AutomationProperties.Name="Message" AutomationProperties.AutomationId="ChatInput"/>
                                            </DockPanel>
                                        </Border>
                                        <Grid>
                                        <TextBlock x:Name="ChatNote" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   MaxWidth="360" Visibility="Collapsed"/>
                                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="18,12">
                                            <ItemsControl x:Name="ChatItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border HorizontalAlignment="{Binding Align}" Background="{Binding Bubble}" CornerRadius="12" Padding="12,8" Margin="0,3" MaxWidth="420">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Body}" Foreground="{Binding Ink}"/>
                                                                <TextBlock Text="{Binding Time}" Foreground="{Binding Ink}" Opacity=".6" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        </Grid>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </local:SidebarTab>

                <!-- ============================== CONTROLLER ============================== -->
                <local:SidebarTab x:Name="ControllerTab" AutomationProperties.Name="Controller">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Controller" VerticalAlignment="Center"/>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <StackPanel Margin="44,38,44,36">
                        <TextBlock Text="INPUT" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Controller" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Pick a layout or change any button: click an action, then press the button on your controller (or pick it from the list). Changes save on their own and apply in game." Style="{StaticResource PageIntro}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="PadDot" Width="8" Height="8" Fill="{StaticResource Faint}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PadStatus" Text="No controller" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <TextBlock Text="Layout" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,8">
                                        <StackPanel x:Name="PresetButtons" Orientation="Horizontal"/>
                                    </Border>
                                </WrapPanel>
                                <CheckBox x:Name="SouthpawToggle" Style="{StaticResource Switch}" Margin="0,8,0,0" Checked="Southpaw_Changed" Unchecked="Southpaw_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Southpaw sticks" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Move with the right stick and look with the left." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Reset to default" Style="{StaticResource Quiet}" Click="ResetController_Click"/>
                                    <TextBlock Text="Buttons" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="ControllerStatus" Style="{StaticResource Hint}" Foreground="{StaticResource Good}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Border x:Name="PickerPanel" Background="#0FFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Quiet}" Click="CancelPick_Click"/>
                                            <TextBlock x:Name="PickerTitle" Text="Press a button on your controller…" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <WrapPanel x:Name="PickerButtons"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="ControllerRows">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Tile}" Margin="0,0,10,8" Click="ControllerAction_Click" Tag="{Binding Key}">
                                                <DockPanel Margin="14,10">
                                                    <Border DockPanel.Dock="Right" Background="{Binding ChipBrush}" CornerRadius="6" Padding="10,4" MinWidth="64">
                                                        <TextBlock Text="{Binding ButtonLabel}" Foreground="{Binding ChipInk}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </local:SidebarTab>

                <!-- ============================== GRAPHICS ============================== -->
                <local:SidebarTab x:Name="GraphicsTab" AutomationProperties.Name="Graphics">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Graphics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <StackPanel Margin="44,38,44,36">
                        <TextBlock Text="PERFORMANCE" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Graphics" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="One click for the smoothest game or the best looks. Changes are saved for the next time you press Play." Style="{StaticResource PageIntro}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Center">
                                        <TextBlock x:Name="GpuText" Text="Graphics card" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Quick setup" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="PresetState" Text="Pick a style." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid Columns="3" Margin="-6,0,-6,0">
                                    <Button x:Name="PresetFps" Style="{StaticResource Tile}" Margin="6" Tag="fps" Click="GraphicsPreset_Click" Height="128">
                                        <StackPanel Margin="16,14">
                                            <DockPanel>
                                                <Border x:Name="PresetFpsChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource Accent}" Visibility="Collapsed">
                                                    <TextBlock Text="ON" Foreground="{StaticResource AccentInk}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}"/>
                                            </DockPanel>
                                            <TextBlock Text="Max FPS" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold" Margin="0,10,0,2"/>
                                            <TextBlock Text="Smoothest play, lowest input lag. Simple effects." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PresetBalanced" Style="{StaticResource Tile}" Margin="6" Tag="balanced" Click="GraphicsPreset_Click" Height="128">
                                        <StackPanel Margin="16,14">
                                            <DockPanel>
                                                <Border x:Name="PresetBalancedChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource Accent}" Visibility="Collapsed">
                                                    <TextBlock Text="ON" Foreground="{StaticResource AccentInk}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}"/>
                                            </DockPanel>
                                            <TextBlock Text="Balanced" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold" Margin="0,10,0,2"/>
                                            <TextBlock Text="Good looks with high frame rates on most PCs." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PresetQuality" Style="{StaticResource Tile}" Margin="6" Tag="quality" Click="GraphicsPreset_Click" Height="128">
                                        <StackPanel Margin="16,14">
                                            <DockPanel>
                                                <Border x:Name="PresetQualityChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource Accent}" Visibility="Collapsed">
                                                    <TextBlock Text="ON" Foreground="{StaticResource AccentInk}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}"/>
                                            </DockPanel>
                                            <TextBlock Text="Best Looks" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold" Margin="0,10,0,2"/>
                                            <TextBlock Text="Highest quality for strong graphics cards." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Display" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                                <TextBlock Text="FPS limit" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FpsHint" Text="Higher is smoother; Unlimited gives the most frames." Style="{StaticResource Hint}" Margin="0,2,0,8"/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel x:Name="FpsButtons" Orientation="Horizontal"/>
                                </Border>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                                <DockPanel>
                                    <TextBlock x:Name="ResolutionValue" DockPanel.Dock="Right" Text="100%" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Render resolution" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="Below 100% gives more FPS (slightly softer picture); above 100% is sharper but slower." Style="{StaticResource Hint}" Margin="0,2,0,4"/>
                                <Slider x:Name="ResolutionSlider" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="GraphicsSlider_Changed"/>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                                <DockPanel>
                                    <TextBlock x:Name="FovValue" DockPanel.Dock="Right" Text="80" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Field of view" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="How much you see around you. 90–110 suits most players." Style="{StaticResource Hint}" Margin="0,2,0,4"/>
                                <Slider x:Name="FovSlider" Minimum="65" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="GraphicsSlider_Changed"/>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                                <TextBlock Text="Display mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeFullscreen" Content="Fullscreen" GroupName="DisplayMode" Style="{StaticResource Segment}" Tag="1" Checked="DisplayMode_Changed"/>
                                        <RadioButton x:Name="ModeBorderless" Content="Borderless" GroupName="DisplayMode" Style="{StaticResource Segment}" Tag="2" Checked="DisplayMode_Changed"/>
                                        <RadioButton x:Name="ModeWindowed" Content="Windowed" GroupName="DisplayMode" Style="{StaticResource Segment}" Tag="0" Checked="DisplayMode_Changed"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Fullscreen usually gives the lowest input lag; Borderless makes Alt+Tab instant." Style="{StaticResource Hint}" Margin="0,6,0,0"/>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                                <CheckBox x:Name="VsyncToggle" Style="{StaticResource Switch}" Checked="GraphicsToggle_Changed" Unchecked="GraphicsToggle_Changed">
                                    <StackPanel>
                                        <TextBlock Text="V-Sync" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Removes screen tearing but caps FPS to your monitor and adds input lag." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ShowFpsToggle" Style="{StaticResource Switch}" Margin="0,12,0,0" Checked="GraphicsToggle_Changed" Unchecked="GraphicsToggle_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Show FPS counter" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Frame rate in the top-right corner of the game." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="DLSS and upscaling" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Black Ops III has no DLSS or FSR: they need support built into the game engine. The closest option: set Render resolution to 75–85% with Balanced, then turn on your graphics driver's sharpening upscaler (NVIDIA Image Scaling in the NVIDIA app, or AMD Radeon Super Resolution)."/>
                                <TextBlock x:Name="RtxTip" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{StaticResource Good}"
                                           Text="RTX card detected: if your NVIDIA app offers Smooth Motion for this game, it can add extra generated frames on top."/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GraphicsStatus" Style="{StaticResource Hint}" Margin="0,12,0,0" Foreground="{StaticResource Good}"/>
                    </StackPanel>
                </local:SidebarTab>

                <!-- ============================== SETTINGS ============================== -->
                <local:SidebarTab x:Name="SettingsTab" AutomationProperties.Name="Settings">
                    <local:SidebarTab.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </local:SidebarTab.Header>
                    <StackPanel Margin="44,38,44,36">
                        <TextBlock Text="SYSTEM" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Game folder, game client, looks and troubleshooting." Style="{StaticResource PageIntro}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Black Ops III folder" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="The folder that contains zone." Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                                <DockPanel>
                                    <Button x:Name="SelectFolderButton" DockPanel.Dock="Right" Content="Browse" Click="SelectFolderButton_Click" Margin="8,0,0,0"/>
                                    <TextBox x:Name="GamePathTextBox" AutomationProperties.Name="Black Ops III game folder" TextChanged="GamePath_Changed"/>
                                </DockPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Save folder" Click="SaveFolder_Click" Margin="0,0,8,0"/>
                                    <Button Content="Open folder" Click="ShowGameFolder_Click" Margin="0,0,8,0"/>
                                    <Button Content="Advanced client settings" Click="ResurgeSettings_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Game client" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="BundleSummary" Style="{StaticResource Hint}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/>
                                <WrapPanel>
                                    <Button Content="Find it for me" Click="FindClient_Click" Margin="0,0,8,0"/>
                                    <Button Content="Choose Resurge.dll" Click="SelectBundle_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Launcher background picture." Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,8">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="BgBlackOps" Content="Black Ops III" GroupName="Background" Style="{StaticResource Segment}" Checked="Background_Changed"/>
                                            <RadioButton x:Name="BgWhiteout" Content="Whiteout" GroupName="Background" Style="{StaticResource Segment}" Checked="Background_Changed"/>
                                            <RadioButton x:Name="BgCustom" Content="My picture" GroupName="Background" Style="{StaticResource Segment}" Checked="Background_Changed"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Choose picture…" Click="ChooseBackground_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,8,0,14"/>
                                <TextBlock Text="Background effect" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Animated layer over the picture. Pauses while the game runs." Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FxEmbers" Content="Embers" GroupName="BackdropEffect" Style="{StaticResource Segment}" IsChecked="True" Checked="Effect_Changed"/>
                                        <RadioButton x:Name="FxSnow" Content="Snow" GroupName="BackdropEffect" Style="{StaticResource Segment}" Checked="Effect_Changed"/>
                                        <RadioButton x:Name="FxOff" Content="Off" GroupName="BackdropEffect" Style="{StaticResource Segment}" Checked="Effect_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Troubleshooting" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Safe launch turns off unlocks and startup scripts for one session. Official maps only also hides Workshop content." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="DiagnosticLaunchButton" Content="Safe launch" Click="DiagnosticLaunch_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="LaunchVanillaButton" Content="Official maps only" Click="LaunchVanilla_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="RestoreButton" Content="Restore files" Click="RestoreFiles_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="OpenLogButton" Content="Open session log" Click="OpenLog_Click" Margin="0,0,8,8"/>
                                    <Button Content="Back up WGS cache" Click="CleanWgsCache_Click" Margin="0,0,8,8"/>
                                    <Button Content="Xbox repair tool" Click="RepairGamingServices_Click" Margin="0,0,8,8"/>
                                    <Button Content="Support" Click="DiscordSupport_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <Expander Header="Installation report" Foreground="{StaticResource Ink}" Margin="0,8,0,0" Expanded="ReportExpander_Expanded">
                                    <TextBox x:Name="DiagnosticsReport" Margin="0,10,0,0" MinHeight="220" MaxHeight="340" IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </local:SidebarTab>
            </TabControl>

            <Border Grid.Row="1" Background="#E6090C11" BorderBrush="#1F2833" BorderThickness="0,1,0,0" Padding="20,10">
                <DockPanel>
                    <TextBlock Text="BLACK OPS III  ·  PC" DockPanel.Dock="Right" FontFamily="{StaticResource Display}" Foreground="{StaticResource Faint}" FontSize="11" Margin="10,1,0,0"/>
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================== SIGN IN ============================== -->
        <Grid x:Name="LoginOverlay" Visibility="Collapsed" Panel.ZIndex="20">
            <Border Background="#D9050709"/>
            <Border x:Name="LoginCard" Style="{StaticResource Card}" Width="720" Padding="34,30" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#F20D1117" BorderBrush="#3A2A20" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LoginScale"/>
                        <TranslateTransform x:Name="LoginShift"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="60" ShadowDepth="0" Opacity=".7"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Border Width="40" Height="40" CornerRadius="9" Background="{StaticResource Accent}">
                            <Path Data="M 0,16 L 8,0 L 12,0 L 5,16 Z M 9,16 L 17,0 L 21,0 L 14,16 Z" Fill="{StaticResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RESURGE" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="20"/>
                            <TextBlock Text="WHITEOUT  ·  BLACK OPS III" FontFamily="{StaticResource Display}" Foreground="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PickPanel">
                        <TextBlock Text="Who's playing?" Style="{StaticResource PageTitle}" FontSize="30"/>
                        <TextBlock Text="Pick your profile. Your friends find you by this name." Style="{StaticResource Hint}" Margin="0,0,0,18"/>
                        <ItemsControl x:Name="ProfileList">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Tile}" Width="150" Height="172" Margin="0,0,12,12" Click="ProfileCard_Click" Tag="{Binding}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Grid Width="78" Height="78">
                                                <Ellipse Fill="#2A3442"/>
                                                <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse Fill="{Binding AvatarBrush}"/>
                                                <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="130"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Tile}" Width="150" Height="58" HorizontalAlignment="Left" Click="NewProfile_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="New profile" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                        <TextBlock x:Name="PasswordTitle" Text="Welcome back" Style="{StaticResource PageTitle}" FontSize="30"/>
                        <TextBlock Text="This profile is protected with a password." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                        <PasswordBox x:Name="LoginPassword" KeyDown="LoginPassword_KeyDown" AutomationProperties.Name="Profile password"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Sign in" Style="{StaticResource Primary}" Click="PasswordSignIn_Click" Margin="0,0,8,0"/>
                            <Button Content="Back" Style="{StaticResource Quiet}" Click="LoginBack_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="CreatePanel" Visibility="Collapsed">
                        <TextBlock Text="New profile" Style="{StaticResource PageTitle}" FontSize="30"/>
                        <TextBlock Text="Pick a name your friends will know you by. The password is optional." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Quiet}" Padding="0" Click="NewAvatar_Click" Margin="0,0,18,0"
                                    ToolTip="Choose a picture" AutomationProperties.Name="Choose a profile picture">
                                <Grid Width="86" Height="86">
                                    <Ellipse Fill="#2A3442"/>
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="NewAvatarPreview"/>
                                    <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="3 2"/>
                                </Grid>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="NAME" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <TextBox x:Name="NewProfileName" MaxLength="24" AutomationProperties.Name="Profile name"/>
                                <TextBlock Text="PASSWORD (OPTIONAL)" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,12,0,6"/>
                                <PasswordBox x:Name="NewProfilePassword" AutomationProperties.Name="Optional profile password"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Create and play" Style="{StaticResource Primary}" Click="CreateProfile_Click" Margin="0,0,8,0"/>
                            <Button Content="Back" Style="{StaticResource Quiet}" Click="LoginBack_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,14"/>
                    <DockPanel>
                        <TextBlock x:Name="LoginError" DockPanel.Dock="Bottom" Foreground="{StaticResource Bad}" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <CheckBox x:Name="RememberMe" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Left">
                            <TextBlock Text="Sign me in automatically on this PC" Foreground="{StaticResource Muted}"/>
                        </CheckBox>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
